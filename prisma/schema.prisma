  unverifiableClaimsCount Int      @default(0)
  summary                 String   @db.Text
  claims                  Json
  projectMatches          Json
  strongProjects          Json
  recommendations         Json
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  resume                  Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([resumeId, createdAt])
  @@index([userId])
  @@map("resume_github_verifications")
}

model CrossPlatformVerification {
  id                                   String   @id @default(uuid())
  userId                               String
  taskId                               String?  @unique
  technicalConsistencyScore            Float    @default(0.0)
  projectConsistencyScore              Float    @default(0.0)
  cpConsistencyScore                   Float    @default(0.0)
  technologyConsistencyScore           Float    @default(0.0)
  overallCoverageScore                 Float    @default(0.0)
  verifiedClaimsCount                  Int      @default(0)
  partialClaimsCount                   Int      @default(0)
  notFoundClaimsCount                  Int      @default(0)
  unverifiableClaimsCount              Int      @default(0)
