model JobDescription {
  id              String         @id @default(uuid())
  userId          String
  title           String
  company         String
  location        String?
  employmentType  String?
  sourceUrl       String?
  rawDescription  String         @db.Text
  normalizedText  String         @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches         JobMatch[]
  readinesses     JobReadiness[]
  companyPreparations CompanyPreparation[]
  careerChats         CareerChat[]
  interviewSessions   InterviewSession[]
  applications        Application[]

  @@index([userId, createdAt])
  @@map("job_descriptions")
}

model JobMatch {
  id                     String         @id @default(uuid())
  jobId                  String
  userId                 String
  taskId                 String?        @unique
  overallMatchScore      Float          @default(0.0)
  matchLabel             String         @default("Strong Alignment")
  requiredSkillCoverage  Float          @default(0.0)
  preferredSkillCoverage Float          @default(0.0)
  projectRelevanceScore  Float          @default(0.0)
  experienceMatchStatus  String         @default("MATCHED")
  educationMatchStatus   String         @default("MATCHED")
  cpRelevanceStatus      String         @default("NOT_APPLICABLE")
  summary                String         @db.Text
  extractedRequirements  Json
  skillMatches           Json
  projectRelevance       Json
  missingSkills          Json
  keywordAlignment       Json
  recommendations        Json
  interviewPriorities    Json
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  job                    JobDescription @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user                   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                   Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@index([userId, createdAt])
  @@map("job_matches")
}

model JobReadiness {
  id                      String         @id @default(uuid())
  jobId                   String
  userId                  String
  taskId                  String?        @unique
  score                   Float          @default(0.0)
  level                   String         @default("DEVELOPING")
  confidence              String         @default("MEDIUM")
  interviewReadinessScore Float          @default(0.0)
  dsaRelevance            String         @default("NOT_REQUIRED")
  dimensions              Json
  criticalGaps            Json
  readinessBlockers       Json
  strongSignals           Json
  weakSignals             Json
  interviewPrep           Json
  preparationPriorities   Json
  projectLeverage         Json
  whatIfSimulation        Json
  executiveSummary        String         @db.Text
  dataFreshness           Json
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  job                     JobDescription @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user                    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                    Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@index([userId, createdAt])
  @@map("job_readinesses")
}

model CompanyPreparation {
  id                            String         @id @default(uuid())
  jobId                         String
  userId                        String
  taskId                        String?        @unique
  companyName                   String
  jobTitle                      String
  jobMatchScore                 Float          @default(0.0)
  jobReadinessScore             Float          @default(0.0)
  preparationCoverageScore      Float          @default(0.0)
  topPriorityTopic              String         @default("")
  companyProfile                Json
  coverageFormulaBreakdown      Json
  priorityEngineFormulaDoc      String         @db.Text
  priorityItems                 Json
  dsaPreparation                Json
  technicalAndSystemDesignPrep  Json
  projectPreparations           Json
  behavioralPreparations        Json
  companyResearch               Json
  resumePositioning             Json
  profileGaps                   Json
  skillTransfers                Json
  roadmap                       Json
  executiveSummary              String         @db.Text
  noFabricationDisclaimer       String         @db.Text
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt

  job                           JobDescription @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user                          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task                          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([jobId, createdAt])
  @@index([userId, createdAt])
  @@map("company_preparations")
}

model CareerChat {
  id          String              @id @default(uuid())
  userId      String
  jobId       String?
  title       String
  mode        String              @default("GENERAL_CAREER_CHAT")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  messages    CareerChatMessage[]
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         JobDescription?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("career_chats")
}

model CareerChatMessage {
  id              String      @id @default(uuid())
  chatId          String
  sender          String      // 'USER' | 'ASSISTANT' | 'SYSTEM' | 'INTERVIEWER' | 'EVALUATOR'
  content         String      @db.Text
  mode            String?
  sourcesUsed     Json?       // string[]
  evidence        Json?       // string[]
  recommendations Json?       // string[]
  score           Float?      // 0-100
  evaluation      Json?       // evaluation breakdown
  createdAt       DateTime    @default(now())

  chat            CareerChat  @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, createdAt])
  @@map("career_chat_messages")
}

model InterviewSession {
  id            String              @id @default(uuid())
  userId        String
  jobId         String?
  interviewType String              @default("Technical")
  difficulty    String              @default("Medium")
  status        String              @default("IN_PROGRESS")
  overallScore  Float?              @default(0.0)
  scoreBreakdown Json?
  finalFeedback String?             @db.Text
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  questions     InterviewQuestion[]
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  job           JobDescription?     @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("interview_sessions")
}

model InterviewQuestion {
  id               String            @id @default(uuid())
  sessionId        String
  questionIndex    Int
  questionText     String            @db.Text
  category         String
  difficulty       String
  expectedKeyPoints Json?
  createdAt        DateTime          @default(now())

  answer           InterviewAnswer?
  session          InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, questionIndex])
  @@map("interview_questions")
}

model InterviewAnswer {
  id            String            @id @default(uuid())
  questionId    String            @unique
  userResponse  String            @db.Text
  score         Float             @default(0.0)
  strengths     Json
  weaknesses    Json
  missingPoints Json
  improvedAnswer String           @db.Text
  createdAt     DateTime          @default(now())

  question      InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("interview_answers")
}

model Application {
  id              String                 @id @default(uuid())
  userId          String
  jobId           String?
  companyName     String
  jobTitle        String
  location        String?
  jobUrl          String?
  applicationDate DateTime               @default(now())
  status          String                 @default("SAVED")
  priority        String                 @default("MEDIUM")
  notes           String?                @db.Text
  salaryRange     String?
  source          String?                @default("OTHER")
  deadline        DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             JobDescription?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  events          ApplicationEvent[]
  followUps       ApplicationFollowUp[]

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([jobId])
  @@map("applications")
}

model ApplicationEvent {
  id            String      @id @default(uuid())
  applicationId String
  type          String
  title         String
  description   String?     @db.Text
  eventDate     DateTime    @default(now())
  createdAt     DateTime    @default(now())

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, eventDate])
  @@map("application_events")
}

model ApplicationFollowUp {
  id            String      @id @default(uuid())
  applicationId String
  title         String
  followUpDate  DateTime
  followUpNote  String?     @db.Text
  completed     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, followUpDate])
  @@map("application_follow_ups")
}

model CareerReport {
  id              String   @id @default(uuid())
  userId          String
  title           String
  type            String   // PROFILE, RESUME, GITHUB, PORTFOLIO, LEETCODE, CODEFORCES, JOB, READINESS, VERIFICATION, COMPANY_PREPARATION, CAREER
  summary         String   @db.Text
  scores          Json?
  strengths       Json?
  gaps            Json?
  recommendations Json?
  evidence        Json?
  sourcesUsed     Json?
  freshnessStatus String   @default("FRESH") // FRESH, STALE, UNAVAILABLE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type])
  @@map("career_reports")
}

model ScheduledJob {
  id                  String                  @id @default(uuid())
  userId              String
  name                String
  description         String?                 @db.Text
  jobType             String                  // GITHUB_SYNC, LEETCODE_SYNC, CODEFORCES_SYNC, PORTFOLIO_REFRESH, RESUME_ANALYSIS, PROFILE_REFRESH, JOB_READINESS_REFRESH, CAREER_REPORT, APPLICATION_FOLLOWUP_CHECK, CAREER_INSIGHT
  schedule            String                  // E.g. "DAILY", "WEEKLY", "MONTHLY", or cron expression "0 9 * * *"
  frequency           String                  @default("DAILY") // DAILY, WEEKLY, MONTHLY, CUSTOM_CRON, INTERVAL
  time                String?                 @default("09:00") // E.g. "09:00"
  timezone            String                  @default("UTC")
  enabled             Boolean                 @default(true)
  status              String                  @default("ACTIVE") // ACTIVE, PAUSED, FAILED, NEEDS_ATTENTION, DISABLED
  resourceId          String?
  lastRunAt           DateTime?
  nextRunAt           DateTime?
  lastStatus          String?
  lastError           String?                 @db.Text
  consecutiveFailures Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions          ScheduledJobExecution[]

  @@index([userId, status])
  @@index([enabled, status, nextRunAt])
  @@map("scheduled_jobs")
}

model ScheduledJobExecution {
  id                  String       @id @default(uuid())
  scheduledJobId      String
  userId              String
  taskId              String?
  scheduledOccurrence DateTime?
  startedAt           DateTime     @default(now())
  completedAt         DateTime?
  status              String       @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, SKIPPED, CANCELLED
  error               String?      @db.Text
  durationMs          Int?
  createdAt           DateTime     @default(now())

  scheduledJob        ScheduledJob @relation(fields: [scheduledJobId], references: [id], onDelete: Cascade)

  @@index([scheduledJobId, createdAt])
  @@index([userId])
  @@index([scheduledJobId, scheduledOccurrence])
  @@map("scheduled_job_executions")
}







