# Database connection string (MySQL)
DATABASE_URL="mysql://user:password@localhost:3306/nexusflow"

# Authentication Secrets & Configurations
JWT_SECRET="your-jwt-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-at-least-32-chars"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# GitHub OAuth Credentials
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

# Google Gemini AI API Configuration
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_REQUEST_TIMEOUT_MS="30000"
GEMINI_MAX_OUTPUT_TOKENS="8192"

# URLs & Server Port Configuration
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"
JAVA_SERVICE_URL="http://localhost:8080"
PORT=3000
NODE_ENV="development"

